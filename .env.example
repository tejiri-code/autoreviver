MONGO_URL=mongodb://autoreviver:autoreviver@mongo:27017/autoreviver?authSource=admin
MONGO_URL_LOCAL=mongodb://autoreviver:autoreviver@localhost:27017/autoreviver?authSource=admin

# ukvehicledata.co.uk — free tier, sign up at https://ukvehicledata.co.uk/
# Faster than DVLA direct (no approval wait). Add your key here.
UKVD_API_KEY=your_key_here

# DVLA VES API — application submitted, use as backup once key arrives
DVLA_API_KEY=mock

# HuggingFace — free key at https://huggingface.co/settings/tokens
HF_API_KEY=hf_your_key_here
HF_TEXT_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HF_IMAGE_MODEL=Salesforce/blip-image-captioning-large

# Optional — seller verification
COMPANIES_HOUSE_API_KEY=optional

AI_API_URL=http://ai-api:8000
AI_API_URL_LOCAL=http://localhost:8000
NODE_ENV=development
PORT=4000
